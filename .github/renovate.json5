{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    // config:recommended plus digest pinning for actions and images,
    // automatic config migration and abandoned-package detection.
    'config:best-practices',
    // Everything here is CI tooling; there's no reason to bump it more than
    // once a week.
    'schedule:weekly',
  ],
  packageRules: [
    {
      // Hold freshly published action releases for a few days so a
      // compromised or broken release has time to be noticed and pulled.
      matchManagers: ['github-actions'],
      minimumReleaseAge: '3 days',
    },
    {
      // Every dependency in this repo only affects CI, so commit as
      // `ci(deps): ...` rather than the default `fix(deps): ...`.
      matchManagers: ['github-actions', 'custom.regex'],
      semanticCommitType: 'ci',
    },
  ],
  customManagers: [
    {
      // validate.yml pins the sandbox-kit frontend that CI validates kits
      // with. Renovate keeps the `3` tag and bumps the digest.
      customType: 'regex',
      description: 'Pinned docker/sandbox-kit frontend used by the validate workflow',
      managerFilePatterns: ['/^\\.github/workflows/validate\\.ya?ml$/'],
      matchStrings: ['SANDBOX_KIT_FRONTEND:\\s*(?<depName>docker/sandbox-kit):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]{64})'],
      datasourceTemplate: 'docker',
    },
  ],
}
